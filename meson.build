project('libinput', 'c',
	version : '0.1',
	license : 'MIT/Expat',
	default_options : [ 'c_std=gnu99', 'warning_level=2' ],
	meson_version : '>= 0.47.0')

# add_global_arguments(global_args, language: 'c')

proj_weston = subproject('weston', default_options: [
	'backend-default=drm',
	'backend-drm=true',
	'backend-drm-screencast-vaapi=false',
	'backend-fbdev=true',
	'backend-headless=true',
	'backend-rdp=false',
	'backend-wayland=true',
	'backend-x11=false',
	'color-management-colord=false',
	'color-management-lcms=true',
	'demo-clients=true',
	'desktop-shell-client-default=weston-desktop-shell',
	'doc=false',
	'image-jpeg=true',
	'image-webp=false',
	'image-png=true',
	'launcher-logind=false',
	'pipewire=false',
	'remoting=false',
	'renderer-gl=true',
	'resize-pool=true',
	'screenshare=true',
	'shell-desktop=true',
	'shell-fullscreen=true',
	'shell-ivi=true',
	'shell-kiosk=true',
	'systemd=false',
	'test-gl-renderer=true',
	'test-junit-xml=false',
	'wcap-decode=false',
	'weston-launch=true',
	'xwayland=false'])